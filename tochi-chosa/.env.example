# 不動産情報ライブラリ API キー（用途地域・建蔽率・容積率・防火地域・地区計画など）
REINFOLIB_API_KEY=
# Claude API キー（AI見解）
ANTHROPIC_API_KEY=
# 使用モデル（省略時 claude-opus-5）
# ANTHROPIC_MODEL=claude-opus-5
# 合言葉（設定すると、ツールを開いたときに入力を求める。公開URLでの無断利用防止）
APP_PASSCODE=
# public にすると http://localhost:3000/ のトップが一般向け「土地しらべ」になる（社内用は /index.html）
# SITE_MODE=public
# 公開時の使いすぎ防止：IPごとの1時間あたりの上限回数（未設定なら制限なし）
# RATE_LIMIT_SURVEY=30
# RATE_LIMIT_INSIGHT=5
